# WhalePath — Environment Variables
# Copy this file to .env.local and fill in your keys

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/whalepath?schema=public

# JWT session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=your_random_secret_here

# Helius RPC API Key (https://helius.dev)
HELIUS_API_KEY=your_helius_api_key_here

# Signal analysis API key
SIGNAL_API_KEY=your_api_key_here

# Optional: public base URL for Blinks/Actions links
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com
