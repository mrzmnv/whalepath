generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id             String   @id @default(uuid())
  signature      String   @unique
  timestamp      BigInt
  walletAddress  String
  walletLabel    String?
  type           String
  tokenSymbol    String
  tokenName      String
  amount         Float
  usdValue       Float
  isAlert        Boolean
  source         String
  createdAt      DateTime @default(now())
}

model Watchlist {
  id        String   @id @default(uuid())
  address   String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model Whale {
  id        String   @id @default(uuid())
  address   String   @unique
  label     String
  category  String?
  tags      String[]
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}
