generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id             String   @id @default(uuid())
  signature      String   @unique
  timestamp      BigInt
  walletAddress  String
  walletLabel    String?
  type           String
  tokenSymbol    String
  tokenName      String
  amount         Float
  usdValue       Float
  isAlert        Boolean
  source         String
  createdAt      DateTime @default(now())
}

model Whale {
  id        String   @id @default(uuid())
  address   String   @unique
  label     String
  category  String?
  tags      String[]
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("user")
  watchlists Watchlist[]
  createdAt DateTime @default(now())
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String
  label     String?
  type      String   @default("favorite") // 'favorite' (whale) or 'personal' (own wallet)
  createdAt DateTime @default(now())

  @@unique([userId, address])
}
